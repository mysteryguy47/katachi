# Copy to .env.local and fill in when each phase is wired up.

# Phase 2 — Database (Neon Postgres)
DATABASE_URL=

# Phase 3 — Auth (Firebase: Google sign-in + phone OTP)
# From Firebase console → Project settings → General → Your apps (Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# From Firebase console → Project settings → Service accounts → Generate new
# private key. Paste the entire downloaded JSON file as ONE line here.
FIREBASE_SERVICE_ACCOUNT=

# Phase 3 — Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Phase 4 — Order confirmation emails (Resend)
# Get a key at resend.com. Until you verify your own domain, use the
# sandbox sender below — it only delivers to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM="Katachi <onboarding@resend.dev>"

# Phase 4 — Product photo/video uploads (Vercel Blob)
# Vercel dashboard → your project → Storage → Create Database → Blob.
# Free on the Hobby plan. On Vercel itself the token is auto-injected —
# but it's named after your store (e.g. `<projectname>_READ_WRITE_TOKEN`),
# not this generic name. See lib/blob/token.ts, which checks both. For
# local dev, copy either variable's value here.
BLOB_READ_WRITE_TOKEN=
